# NSTY nights docroot.
# HTTPS redirects and HSTS are intentionally not configured.
# Enable them only after a certificate is valid for both names.
# The switch is documented in docs/DEPLOYMENT.md and is not present here.

Options -Indexes

RewriteEngine On

# Block dotfiles and dot-directories. Permit ACME HTTP-01 under /.well-known/
RewriteRule "(^|/)\.(?!well-known(?:/|$))" - [F]

# Block sensitive extensions anywhere in the tree. This site ships no PHP.
RewriteRule "(?i)\.(?:env|zip|sql|bak|log|ini|php|phps|phtml|phar)$" - [F]

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'none'; frame-ancestors 'self'; frame-src 'none'; object-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'none'; media-src 'self'; worker-src 'none'; manifest-src 'self'"
  SetEnvIf Request_URI "^/test($|/)" NST_PREVIEW
  Header set X-Robots-Tag "noindex, nofollow" env=NST_PREVIEW
</IfModule>

<IfModule mod_mime.c>
  AddType image/svg+xml .svg
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddDefaultCharset UTF-8
</IfModule>
